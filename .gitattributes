# Set default behavior to automatically normalize line endings to LF.
* text=auto eol=lf

# Explicitly declare text files to ensure consistent handling.
*.css             text eol=lf
*.html            text eol=lf
*.js              text eol=lf
*.json            text eol=lf
*.jsx             text eol=lf
*.md              text eol=lf
*.scss            text eol=lf
*.svg             text eol=lf
*.ts              text eol=lf
*.tsx             text eol=lf
*.xml             text eol=lf
.gitattributes    text eol=lf
.gitignore        text eol=lf
.prettierrc       text eol=lf
.eslintrc.json    text eol=lf

# Declare files that are binary and should not be modified.
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.ico             binary
*.webp            binary
*.eot             binary
*.ttf             binary
*.woff            binary
*.woff2           binary
