{
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 100,
    "useTabs": false,
    "endOfLine": "lf",
    "tabWidth": 2,
    "overrides": [
        {
            "files": "*.json",
            "options": {
                "tabWidth": 4
            }
        },
        {
            "files": "*.jsonc",
            "options": {
                "tabWidth": 4
            }
        }
    ]
}